{
  "name": "weathercloud-api",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAPI specification and Cloudflare Forge documentation pipeline for Weathercloud",
  "scripts": {
    "lint": "npm run lint:openapi && npm run lint:fern",
    "lint:openapi": "redocly lint openapi.yaml --skip-rule operation-4xx-response",
    "lint:fern": "fern check",
    "docs": "redocly bundle openapi.yaml -o docs/openapi.json --ext json",
    "generate": "fern generate --local --force",
    "generate:python": "fern generate --group python-sdk --local --force",
    "generate:csharp": "fern generate --group csharp-sdk --local --force",
    "generate:typescript": "fern generate --group typescript-sdk --local --force --package",
    "generate:go": "fern generate --group go-sdk --local --force",
    "generate:rust": "fern generate --group rust-sdk --local --force"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.0",
    "fern-api": "^5.140.0"
  }
}
